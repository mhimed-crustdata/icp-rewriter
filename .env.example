# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Your account export (columns: domain, plan)
ACCOUNTS_CSV=accounts.csv
MIN_SUPPORT=3
MIN_LIFT=1.25

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Notion page for the ICP (internal integration token + parent page id)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
